{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["assets/scripts/core/**/*.ts", "assets/scripts/game/**/*.ts", "assets/scripts/platform/**/*.ts", "tools/**/*.ts"]
}
